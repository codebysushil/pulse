{
    "name": "pulsephp/pulse",
    "description": "💗 PulsePHP: async library provide event loop, promises and async/await like syntax.",
    "type": "library",
    "keywords": [
        "pulse",
        "pulsephp",
        "async",
        "await",
        "async-await",
        "event-loop",
        "promise",
        "non-blocking I/O"
    ],
    "require": {
        "php": "^8.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Pulse\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "authors": [
        {
            "name": "Sushil Kumar",
            "email": "sushilkumbhar77@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
